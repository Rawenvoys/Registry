@page "/register"
@layout AuthLayout
@inject IAuthApi AuthApi
@inject NavigationManager Navigation

<PageTitle>Rejestracja · Registry</PageTitle>

@if (_registeredEmail is null)
{
    <h1 class="h4 mb-4">Załóż konto</h1>

    <ExternalSignInButtons OnSignedIn="@(() => Navigation.NavigateTo(""))" OnFailed="@(p => _errors = [p.Detail ?? "Logowanie nie powiodło się."])" />

    <EditForm Model="_model" OnValidSubmit="RegisterAsync" FormName="register">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="email" class="form-label">E-mail</label>
            <InputText id="email" type="email" class="form-control" autocomplete="username" @bind-Value="_model.Email" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Hasło</label>
            <InputText id="password" type="password" class="form-control" autocomplete="new-password" @bind-Value="_model.Password" />
            <div class="form-text">Co najmniej 8 znaków, w tym wielka i mała litera oraz cyfra.</div>
            <ValidationMessage For="() => _model.Password" />
        </div>

        <div class="mb-3">
            <label for="confirm" class="form-label">Powtórz hasło</label>
            <InputText id="confirm" type="password" class="form-control" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
            <ValidationMessage For="() => _model.ConfirmPassword" />
        </div>

        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in _errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <div class="d-grid">
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "Zakładanie konta…" : "Załóż konto")</button>
        </div>
    </EditForm>

    <p class="mt-4 mb-0 text-center">
        Masz już konto? <a href="login">Zaloguj się</a>
    </p>
}
else
{
    <h1 class="h4 mb-3">Sprawdź skrzynkę</h1>
    <p>Wysłaliśmy link potwierdzający na <strong>@_registeredEmail</strong>. Kliknij go, a potem zaloguj się.</p>

    @if (_resent)
    {
        <div class="alert alert-success" role="status">Wysłaliśmy nowy link.</div>
    }

    <div class="d-grid gap-2">
        <a class="btn btn-primary" href="login">Przejdź do logowania</a>
        <button type="button" class="btn btn-link" disabled="@_busy" @onclick="ResendAsync">Nie dostałem wiadomości, wyślij ponownie</button>
    </div>
}

@code {
    private readonly RegisterModel _model = new();
    private List<string> _errors = [];
    private bool _busy;
    private bool _resent;
    private string? _registeredEmail;

    private async Task RegisterAsync()
    {
        _busy = true;
        _errors = [];
        try
        {
            var response = await AuthApi.RegisterAsync(new PasswordCredentials(_model.Email, _model.Password));
            if (response.IsSuccessful)
            {
                _registeredEmail = _model.Email;
                return;
            }

            var problem = ApiProblem.From(response.Error);
            _errors = problem switch
            {
                { IsNetworkError: true } => ["Brak połączenia z serwerem. Spróbuj ponownie."],
                { Errors.Count: > 0 } => problem.Errors.Select(e => IdentityErrors.Describe(e.Key, e.Value.FirstOrDefault())).Distinct().ToList(),
                _ => ["Nie udało się założyć konta. Spróbuj ponownie."],
            };
        }
        catch (HttpRequestException)
        {
            _errors = ["Brak połączenia z serwerem. Spróbuj ponownie."];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendAsync()
    {
        _busy = true;
        try
        {
            await AuthApi.ResendConfirmationEmailAsync(new EmailRequest(_registeredEmail!));
            _resent = true;
        }
        catch (HttpRequestException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Podaj e-mail.")]
        [EmailAddress(ErrorMessage = "To nie wygląda na adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj hasło.")]
        [MinLength(8, ErrorMessage = "Hasło musi mieć co najmniej 8 znaków.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Hasła się różnią.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
